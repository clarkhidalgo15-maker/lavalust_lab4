# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For Aiven, use the values from the service overview and set DB_NAME to the
# database where the users table was created (for example: defaultdb).
# Aiven requires SSL; configure the Render service with SSL enabled.
